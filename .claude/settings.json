{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm run test:watch)",
      "Bash(npm run dev)",
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx supabase *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(npx @claude-flow*)",
      "Bash(npx claude-flow*)",
      "Bash(node .claude/*)",
      "mcp__claude-flow__:*"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const f=process.env.CLAUDE_HOOK_FILE||'';if(!/\\.(ts|tsx|js|jsx|mjs)$/.test(f))process.exit(0);const{spawnSync}=require('child_process');const r=spawnSync('npx',['eslint','--fix','--max-warnings=0',f],{stdio:'inherit',shell:true});process.exit(r.status||0);\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "ruflo-core@ruflo": true,
    "ruflo-swarm@ruflo": true,
    "ruflo-rag-memory@ruflo": true,
    "ruflo-neural-trader@ruflo": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_FLOW_V3_ENABLED": "true",
    "CLAUDE_FLOW_HOOKS_ENABLED": "true"
  }
}