# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Allow the example file — it contains no real secrets
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Claude Code workspace — share project commands/agents/settings with the
# team; keep per-machine worktrees + transcripts local.
.claude/*
!.claude/commands/
!.claude/agents/
!.claude/settings.json

# supabase cli temp state (auto-generated)
supabase/.temp/

# jupyter notebook checkpoints
.ipynb_checkpoints/